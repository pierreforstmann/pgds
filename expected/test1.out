--
-- test1.sql
create extension pgds;
--
create table t1(x int);
create table t2(x int);
--
select * from t1;
NOTICE:  pgds: pgds_analyze_table: analyze: t1
 x 
---
(0 rows)

select * from t1;
NOTICE:  pgds: pgds_analyze_table: analyze: t1
 x 
---
(0 rows)

--
begin;
insert into t2 values(2);
NOTICE:  pgds: pgds_analyze_table: analyze: t2
select * from t2;
NOTICE:  pgds: pgds_analyze_table: analyze: t2
 x 
---
 2
(1 row)

select * from t2;
 x 
---
 2
(1 row)

commit;
select * from t2;
 x 
---
 2
(1 row)

--
select * from t1;
NOTICE:  pgds: pgds_analyze_table: analyze: t1
 x 
---
(0 rows)

